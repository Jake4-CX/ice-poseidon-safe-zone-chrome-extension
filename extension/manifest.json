{
  "manifest_version": 3,
  "name": "SafeZone+",
  "version": "0.3.0",
  "description": "Search players, star favourites, watch their Kick streams and get alerts on Ice Poseidon's Safe Zone map.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the Safe Zone map",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://kick.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://iceposeidon.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://iceposeidon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
